{
  "name": "abbi-ng-ai-image-descriptor",
  "version": "3.1.0",
  "description": "Angular web app for AI-generated image descriptions",
  "homepage": "https://github.com/slsfi/abbi-ng-ai-image-descriptor#readme",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node prebuild-generate-app-version.ts",
